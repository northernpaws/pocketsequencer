{
    "rust-analyzer.cargo.target": "thumbv7em-none-eabihf",
    // "rust-analyzer.checkOnSave": false,
    "rust-analyzer.linkedProjects": [
        "firmware/mainboard/Cargo.toml",
        "firmware/mainboard/crates/graphics/Cargo.toml",
        "firmware/mainboard/tools/graphics-simulator/Cargo.toml"
    ],
    "cmake.sourceDirectory": "${workspaceRoot}/firmware/wireless",
    "nrf-connect.applications": [
        "${workspaceFolder}/firmware/wireless"
    ],
    "nrf-connect.boardRoots": [
        "${workspaceFolder}/firmware/wireless"
    ],
    "files.associations": {
        "uart_async_adapter.h": "c",
        "log.h": "c",
        "nrfx_log.h": "c"
    },
    "device-manager.manageAllDevices": true
}