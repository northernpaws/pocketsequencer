		(uuid "7e81660e-ceef-4652-9c1c-c3b87d92fc3c")
	)
	(text "Despite the latter having a larger package, SDRAM footprints for\n54-TFBGA 16Mx16 and 32Mx16 are interchangable and just require\nsetting the FMC column address bits to 8 or 9 respectively on the\nfirmware driver side.\n\nThe footprint used here is interchangable for both, allowing\nselecting either 256Mbits or 512Mbits memory based on the IC\nused to populate the footprint.\n\nA jumper is used to select which package is installed."
		(exclude_from_sim no)
		(at 297.942 354.076 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8941037f-8f18-4327-835e-d8cce9f2cbab")
	)
	(text "ESP32-C6 uses UART0 on\n16/17 for programming."
		(exclude_from_sim no)
		(at -2.54 292.608 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 132 132 132 1)
			)
			(justify right)
		)
		(uuid "a51ebf47-55d0-4902-912c-1c6e07864b9f")
	)
	(text "Pull-down holds display in\nreset until the MCU is ready\nto initialize the display."
		(exclude_from_sim no)
		(at -47.498 107.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right)
		)
		(uuid "bc2fa7a3-8aba-47d7-aac3-5c3d46951c85")
	)
	(text "For download mode:\nGPIO8=1\nGPIO9=0"
		(exclude_from_sim no)
		(at -24.638 283.464 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 132 132 132 1)
			)
			(justify right)
